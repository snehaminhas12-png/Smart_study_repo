# Copy this file to .env and paste your own Gemini key after the equals sign.
# Do not commit or upload .env to GitHub.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE
VAPID_PUBLIC_KEY=PASTE_PUBLIC_KEY_FROM_GENERATE_VAPID
VAPID_PRIVATE_KEY=PASTE_PRIVATE_KEY_FROM_GENERATE_VAPID
VAPID_SUBJECT=mailto:YOUR_EMAIL_ADDRESS
# For a paid Render service with a persistent disk mounted at /var/data:
# DATABASE_PATH=/var/data/subscriptions.sqlite3
